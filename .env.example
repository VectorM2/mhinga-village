# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://mhinga.co.za

# TAMS (Traditional Authority Management System) — "Apply for land online"
# links go to <this URL>/register, the resident create-account page
NEXT_PUBLIC_TAMS_URL=http://localhost:5173

# Supabase — leave empty to run on local mock data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional map provider (OpenStreetMap needs no key)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_FIXED_NOW=2026-10-07T12:00:00+02:00
